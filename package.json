{
  "name": "ding-ding-app-store",
  "version": "0.1.0",
  "private": false,
  "description": "Material Design 3 desktop app store for Ding Ding Projects.",
  "author": "Ding Ding Projects",
  "license": "Apache-2.0",
  "homepage": "https://ding-ding-projects.github.io/ding-ding-app-store/",
  "main": "dist/main/main.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "prove:guest-lifecycle": "node scripts/prove-guest-lifecycle.mjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "check": "npm run docs:check && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit && vitest run tests && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present",
    "count:lines": "node scripts/count-lines.mjs",
    "release:changelog": "node scripts/generate-release-changelog.mjs",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "test": "vitest run tests",
    "dist": "npm run build && electron-builder --win squirrel --publish never",
    "docs:generate": "node scripts/docs-generate.mjs",
    "docs:check": "node scripts/docs-generate.mjs --check",
    "proof:lifecycle": "node scripts/lifecycle-proof.mjs",
    "proof:lifecycle:aggregate": "node scripts/aggregate-lifecycle-proof.mjs",
    "proof:source-lifecycle": "node scripts/source-lifecycle-proof.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "org.dingdingprojects.appstore",
    "productName": "Ding Ding App Store",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json"
    ],
    "icon": "assets/ding-ding-app-store.ico",
    "win": {
      "icon": "assets/ding-ding-app-store.ico",
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "signExecutable": false
    },
    "squirrelWindows": {
      "name": "DingDingAppStore",
      "artifactName": "DingDingAppStore-Setup.${ext}",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/ding-ding-app-store/main/assets/ding-ding-app-store.ico",
      "msi": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Ding-Ding-Projects/ding-ding-app-store/releases/latest/download/"
    }
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true
  }
}
